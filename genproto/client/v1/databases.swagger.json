        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "format": "int64",
          "title": "用户 collection 的 OCC `_version`；系统资源不经本字段。"
        }
      },
      "title": "Document 是文档 RPC 的共享载荷。"
    },
    "v1Empty": {
      "type": "object"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
