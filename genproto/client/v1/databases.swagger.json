          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1Filter": {
      "type": "object",
      "properties": {
        "eq": {
          "$ref": "#/definitions/v1Comparison"
        },
        "ne": {
          "$ref": "#/definitions/v1Comparison"
        },
        "lt": {
          "$ref": "#/definitions/v1Comparison"
        },
        "lte": {
          "$ref": "#/definitions/v1Comparison"
        },
        "gt": {
          "$ref": "#/definitions/v1Comparison"
        },
        "gte": {
          "$ref": "#/definitions/v1Comparison"
        },
        "in": {
          "$ref": "#/definitions/v1Comparison"
        },
        "contains": {
          "$ref": "#/definitions/v1Comparison"
        },
        "starts_with": {
          "$ref": "#/definitions/v1Comparison"
        },
        "ends_with": {
          "$ref": "#/definitions/v1Comparison"
        },
        "search": {
          "$ref": "#/definitions/v1Comparison"
        },
        "and": {
          "$ref": "#/definitions/v1FilterList"
        },
        "or": {
          "$ref": "#/definitions/v1FilterList"
        },
        "between": {
          "$ref": "#/definitions/v1Comparison"
        },
        "is_null": {
          "$ref": "#/definitions/v1Comparison"
        },
        "is_not_null": {
          "$ref": "#/definitions/v1Comparison"
        },
        "not_between": {
          "$ref": "#/definitions/v1Comparison"
        },
        "not_contains": {
          "$ref": "#/definitions/v1Comparison"
        },
        "not_starts_with": {
          "$ref": "#/definitions/v1Comparison"
        },
        "not_ends_with": {
          "$ref": "#/definitions/v1Comparison"
        },
        "not_search": {
          "$ref": "#/definitions/v1Comparison"
        }
      },
      "description": "Filter is a boolean expression tree (single-AST, C7). Comparison ops use\nAppwrite-equivalent semantics; and/or are recursive (depth \u003c= 8). Negation\nis expressed by not* variants only (index-friendly); there is no generic\nNOT operator."
    },
    "v1FilterList": {
      "type": "object",
      "properties": {
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Filter"
          }
        }
      },
      "description": "FilterList is a boolean combination of Filter nodes (and / or)."
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1Order": {
      "type": "object",
      "properties": {
        "attribute": {
          "type": "string"
        },
        "desc": {
          "type": "boolean"
        }
      },
      "description": "Order is a single sort key. desc=false is ascending."
    },
    "v1Query": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1Filter"
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Order"
          }
        },
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "page_token": {
          "type": "string"
        },
        "select": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Projection: server trims the returned Data to these fields."
        }
      },
      "description": "Query is the single wire form of document list/count/aggregate filters\n(C7: the server consumes no query strings; the Appwrite DSL survives only\nas client-side sugar in SDKs/tools). page_token is the authoritative pager\n(K-20); page_size is the page bound."
    }
  },
