      "title": "CountDocumentsRequest 独立于 ListDocumentsRequest（P3-9）：不暴露无效分页参数（page_size/page_token）。"
    },
    "torchwoodclientv1DatabasesServiceCreateDocumentBody": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "title": "客户端自选 document_id；documents:count 为自定义方法段（REST 自定义动词），\n不再占用 document_id 命名空间，可自由取任意合法值。"
        },
        "data": {
          "type": "object"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request_id": {
          "type": "string",
          "title": "写幂等键（redesign §4.1/§10.1）：作用域 (project, actor, request_id)，\n24h 内同键重放返回首次成功响应（响应头 x-torchwood-replayed: true）；\n同键不同请求 → IDEMPOTENCY.KEY_CONFLICT。HTTP 面等价 Idempotency-Key 头。"
        }
      }
    },
    "torchwoodclientv1DatabasesServiceUpdateDocumentBody": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "increment": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "int64"
          }
        },
        "version": {
          "type": "string",
          "format": "int64",
          "title": "用户集合强制 OCC：必须与当前行 _version 相等；未设置 = version_required。"
        },
        "request_id": {
          "type": "string",
          "title": "写幂等键，语义同 CreateDocumentRequest.request_id。"
        }
      }
    },
