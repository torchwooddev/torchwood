    "v1Change": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "string",
          "format": "int64"
        },
        "event_id": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "title": "事件名：databases.documents.create | update | delete。"
        },
        "document_id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "format": "int64"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "truncated": {
          "type": "boolean"
        },
        "data": {
          "$ref": "#/definitions/v1Document",
          "title": "写后全文档（delete 事件缺省）。"
        },
        "transaction_id": {
          "type": "string"
        }
      },
      "title": "Change 是一条已提交的文档写事件（阶段④ §4.5，:changes / last_seq 重放\n的出站形态）。seq 为 outbox 全局分配序（集合内分配序、可能有空洞——\n空洞 = 回滚事务，不丢事件）；delete 事件 data 为空（天然 tombstone：\ndocument_id + version 标识删除）。transaction_id 非空表示事件来自\nexecute-tx 原子批（批内事件顺序 = op 序）。"
    },
    "v1Comparison": {
      "type": "object",
      "properties": {
        "attribute": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Comparison is a leaf predicate: attribute plus zero or more values.\nValue arity per operator: eq/ne/lt/lte/gt/gte/in/contains/starts_with/\nends_with/search \u003e= 1; between/not_between exactly 2; is_null/is_not_null 0."
    },
    "v1Document": {
      "type": "object",
      "properties": {
