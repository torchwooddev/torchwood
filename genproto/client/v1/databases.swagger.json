            "type": "string"
          }
        },
        "request_id": {
          "type": "string",
          "title": "写幂等键，语义同 CreateDocumentRequest.request_id。"
        }
      }
    },
    "torchwoodclientv1ListChangesResponse": {
      "type": "object",
      "properties": {
