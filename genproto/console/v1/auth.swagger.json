{
  "swagger": "2.0",
  "info": {
    "title": "console/v1/auth.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "ConsoleAuthService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/console/auth/refresh": {
      "post": {
        "operationId": "ConsoleAuthService_RefreshToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignInResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1RefreshTokenRequest"
            }
          }
        ],
        "tags": [
          "ConsoleAuthService"
        ]
      }
    },
    "/v1/console/auth/setup-status": {
      "get": {
        "summary": "查询是否已完成初始化（admins 是否为空）。",
        "operationId": "ConsoleAuthService_GetSetupStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetSetupStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "ConsoleAuthService"
        ]
      }
    },
    "/v1/console/auth/sign-in": {
      "post": {
        "operationId": "ConsoleAuthService_SignIn",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignInResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignInRequest"
            }
          }
        ],
        "tags": [
          "ConsoleAuthService"
        ]
      }
    },
    "/v1/console/auth/sign-out": {
      "post": {
        "operationId": "ConsoleAuthService_SignOut",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Empty"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignOutRequest"
            }
          }
        ],
        "tags": [
          "ConsoleAuthService"
        ]
      }
    },
    "/v1/console/auth/sign-up": {
      "post": {
        "summary": "首个管理员注册：仅当 admins 表为空且携带正确 setup token 时可用；\r\n须同时指定 project_id 与 database_id，创建 owner + 项目 + 数据库。\r\n不生成 API Key，登录后在 Console 的 API Key 页面创建。",
        "operationId": "ConsoleAuthService_SignUp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignUpResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignUpRequest"
            }
          }
        ],
        "tags": [
          "ConsoleAuthService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "torchwoodconsolev1RefreshTokenRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "torchwoodconsolev1SignInRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "torchwoodconsolev1SignInResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "torchwoodconsolev1SignOutRequest": {
      "type": "object"
    },
    "torchwoodconsolev1SignUpRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "setupToken": {
          "type": "string",
          "title": "Console 引导令牌（security.setup_token / TORCHWOOD_SECURITY_SETUP_TOKEN）。"
        },
        "projectId": {
          "type": "string",
          "title": "首个项目 ID，须匹配 ^[a-z][a-z0-9]{0,27}$。"
        },
        "databaseId": {
          "type": "string",
          "title": "首个业务数据库 ID，规则同 project_id。CreateProject 把它作为第一业务库\r\n创建（缺省 default）；系统集合在项目数据面 tw_\u003cproject\u003e，不在该库。"
        }
      }
    },
    "torchwoodconsolev1SignUpResponse": {
      "type": "object",
      "properties": {
        "admin": {
          "$ref": "#/definitions/v1Admin",
          "title": "复用 admins.proto 的 Admin 消息"
        },
        "accessToken": {
          "type": "string",
          "title": "与 SignInResponse 一致，便于前端统一处理"
        },
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "v1Admin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1Empty": {
      "type": "object"
    },
    "v1GetSetupStatusResponse": {
      "type": "object",
      "properties": {
        "needsSetup": {
          "type": "boolean"
        },
        "setupTokenRequired": {
          "type": "boolean",
          "title": "部署方是否配置了 TORCHWOOD_SECURITY_SETUP_TOKEN；为 true 时登录页\r\n需展示 setup token 输入框。"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "格式: Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "项目绑定在密钥行上，不需要 X-Torchwood-Project。该头仅 Console admin 会话切换项目。",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e（Console admin 会话）",
      "name": "Cookie",
      "in": "header"
    }
  },
  "x-torchwood-access": "public"
}
